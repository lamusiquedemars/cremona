APP_NAME=Cremona
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cremona
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# PWA (surcharger ces valeurs dans chaque installation client si nécessaire)
PWA_APP_NAME="${APP_NAME}"
PWA_APP_SHORT_NAME=Cremona
PWA_APP_DESCRIPTION="L’espace de pilotage Cremona."
PWA_START_URL=/dashboard
PWA_SCOPE=/
PWA_THEME_COLOR=#f59e0b
PWA_BACKGROUND_COLOR=#faf8f3
# PWA_ICON_192=/pwa/icons/cremona-192.png
# PWA_ICON_512=/pwa/icons/cremona-512.png
# PWA_APPLE_TOUCH_ICON=/pwa/icons/cremona-180.png

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Shared Maracuja Google Ads infrastructure (never exposed to organizations)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# pending | basic | standard. Never enter "test" for production client accounts.
GOOGLE_ADS_API_ACCESS_LEVEL=pending

VITE_APP_NAME="${APP_NAME}"
