APP_NAME=Cremona
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cremona
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

SESSION_DRIVER=database
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# PWA (surcharger ces valeurs dans chaque installation client si nécessaire)
PWA_APP_NAME="${APP_NAME}"
PWA_APP_SHORT_NAME=Cremona
PWA_APP_DESCRIPTION="L’espace de pilotage Cremona."
PWA_START_URL=/dashboard
PWA_SCOPE=/
PWA_THEME_COLOR=#f59e0b
PWA_BACKGROUND_COLOR=#faf8f3
# PWA_ICON_192=/pwa/icons/cremona-192.png
# PWA_ICON_512=/pwa/icons/cremona-512.png
# PWA_APPLE_TOUCH_ICON=/pwa/icons/cremona-180.png

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Documents clients, contrats et pièces métier : local pour le développement,
# scaleway-private en production lorsque le bucket Scaleway privé est configuré.
PRIVATE_DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ScaleWay Object Storage est compatible S3 ; aucun service AWS n'est utilisé.
SCW_OBJECT_STORAGE_ACCESS_KEY=
SCW_OBJECT_STORAGE_SECRET_KEY=
SCW_OBJECT_STORAGE_REGION=fr-par
SCW_OBJECT_STORAGE_ENDPOINT=https://s3.fr-par.scw.cloud
SCW_OBJECT_STORAGE_PATH_STYLE=false
SCW_PRIVATE_DOCUMENTS_BUCKET=

# Shared Maracuja Google Ads infrastructure (never exposed to organizations)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_OAUTH_CLIENT_ID=
GOOGLE_ADS_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# pending | basic | standard. Never enter "test" for production client accounts.
GOOGLE_ADS_API_ACCESS_LEVEL=pending

# Super PDP sandbox: one confidential OAuth client per connected organization.
# Never commit real identifiers or secrets; use .env in each environment.
SUPER_PDP_SANDBOX_CLIENT_ID=
SUPER_PDP_SANDBOX_CLIENT_SECRET=
SUPER_PDP_SANDBOX_COMPANY_LABEL="Burger Queen"
SUPER_PDP_API_URL=https://api.superpdp.tech

VITE_APP_NAME="${APP_NAME}"
